# Copy this file to .env and change the values.
PORT=5000
# Local MongoDB (install MongoDB Community Server, or use a MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/toolshed_mern
# Secret used to sign and verify JSON Web Tokens - use a long random string
JWT_SECRET=change-this-to-a-long-random-secret
# Web Push (VAPID) keys for PWA push notifications.
# Generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@toolshed.example
